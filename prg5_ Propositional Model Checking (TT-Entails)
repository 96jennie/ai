def evaluate_kb(models):
    # Knowledge Base: P -> Q, P
    return (not models['P'] or models['Q']) and models['P']


def tt_entails(symbols, models, query):
    if not symbols:
        if evaluate_kb(models):
            return models[query]
        return True

    p = symbols[0]
    rest = symbols[1:]

    return (
        tt_entails(rest, {**models, p: True}, query)
        and
        tt_entails(rest, {**models, p: False}, query)
    )


print(
    "TT-Entails Evaluation (Does KB entail Q?):",
    tt_entails(['P', 'Q'], {}, 'Q')
)
