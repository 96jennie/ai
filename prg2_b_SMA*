import heapq

graph = {
    'A': {'B': 1, 'C': 3},
    'B': {'D': 3, 'E': 1},
    'C': {'F': 5},
    'D': {'G': 2},
    'E': {'G': 4},
    'F': {'G': 1},
    'G': {}
}

heuristic = {
    'A': 7,
    'B': 6,
    'C': 4,
    'D': 2,
    'E': 3,
    'F': 1,
    'G': 0
}


def astar(start, goal):
    open_list = [(heuristic[start], 0, start, [start])]
    visited = set()

    while open_list:
        f, g, node, path = heapq.heappop(open_list)

        if node == goal:
            return path, g

        if node in visited:
            continue

        visited.add(node)

        for neighbor, cost in graph[node].items():
            if neighbor not in visited:
                new_g = g + cost
                new_f = new_g + heuristic[neighbor]
                heapq.heappush(
                    open_list,
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    return None, float('inf')


def sma_star(start, goal, memory_limit=3):
    open_list = [(heuristic[start], 0, start, [start])]
    visited = set()

    while open_list:
        if len(open_list) > memory_limit:
            open_list.sort()
            open_list.pop()  

        open_list.sort()
        f, g, node, path = open_list.pop(0)

        if node == goal:
            return path, g

        if node in visited:
            continue

        visited.add(node)

        for neighbor, cost in graph[node].items():
            if neighbor not in visited:
                new_g = g + cost
                new_f = new_g + heuristic[neighbor]
                open_list.append(
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    return None, float('inf')


path, cost = astar('A', 'G')
print("A* Path:", path)
print("A* Cost:", cost)

path2, cost2 = sma_star('A', 'G')
print("\nSMA* Path:", path2)
print("SMA* Cost:", cost2)
